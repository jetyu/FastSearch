{
  "name": "Fast Search",
  "description": "快速切换搜索引擎，支持划词搜索、全局搜索和自定义搜索入口",
  "version": "1.6.0",
  "homepage_url": "https://github.com/jetyu/FastSearch",
  "icons": {
    "16": "assets/fast-search-16.png",
    "32": "assets/fast-search-32.png",
    "48": "assets/fast-search-48.png",
    "128": "assets/fast-search-128.png"
  },
  "action": {
    "default_title": "打开 Fast Search",
    "default_icon": {
      "16": "assets/fast-search-16.png",
      "32": "assets/fast-search-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-scripts/main.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "commands": {
    "open-fast-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "打开 Fast Search 搜索面板"
    }
  },
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["assets/*"]
    }
  ],
  "permissions": ["storage"],
  "manifest_version": 3
}
